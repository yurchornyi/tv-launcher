<?xml version="1.0" encoding="utf-8"?>
<!-- Menus, panels and dialogs over Home: the top bar buttons' own glass (pill_bg, icon_button_bg: the same gradient
     and hairline), laid over a dark scrim. Bare, as on a button, it let a bright poster through behind the words. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D914161A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Continue watching on the Now Playing card of a film: the same glass pill as the shelf's Continue (pill_bg's
     colours, in the 46dp shape of the close button beside it), filled as far as the film was watched (the clip's
     level, set and swept by MainActivity; full when the length is unknown). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/icon_button_bg" />
    <item
        android:id="@+id/npResumeFill"
        android:drawable="@drawable/pill_fill"
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp" />
</layer-list>

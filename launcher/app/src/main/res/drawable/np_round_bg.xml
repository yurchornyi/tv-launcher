<?xml version="1.0" encoding="utf-8"?>
<!-- The round close button beside Continue watching: the same 46dp height, dark glass at rest, white in focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#40FFFFFF" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#59000000" />
            <stroke android:width="1.5dp" android:color="#59FFFFFF" />
        </shape>
    </item>
</selector>

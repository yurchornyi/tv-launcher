<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf art (config.xml top_shelf_art): the focused dock app's banner, heavily softened, washing the
         screen behind the shelf, with a fade into the background towards the dock. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/heroFade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/top_shelf_fade"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Title of the TMDB backdrop on the top shelf (shelf_feed_apps), positioned above the dock in code. -->
    <TextView
        android:id="@+id/shelfTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:maxWidth="560dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp"
        android:fontFamily="@font/outfit_medium"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.08"
        android:ellipsize="end"
        android:shadowColor="#99000000"
        android:shadowRadius="12"
        android:shadowDy="2" />

    <!-- The line under the search row (MainActivity.showSearchNote): the AI thinking, why a pick fits. -->
    <TextView
        android:id="@+id/searchNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:maxWidth="760dp"
        android:visibility="gone"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/outfit_regular"
        android:maxLines="2"
        android:ellipsize="end"
        android:shadowColor="#99000000"
        android:shadowRadius="10" />

    <!-- A red LIVE pill above the title while the shelf shows a live stream (ChannelFeed item.live). -->
    <TextView
        android:id="@+id/shelfLive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:alpha="0"
        android:visibility="gone"
        android:background="@drawable/live_badge_bg"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.12"
        android:fontFamily="@font/outfit_medium"
        android:includeFontPadding="false"
        android:text="@string/live_badge" />

    <!-- The app's chosen live channels (LiveChannels), a row of logo tiles above the dock; Up from the dock lands
         here, OK opens the channel in the app. Built in code; hidden while the shelf shows something else. -->
    <HorizontalScrollView
        android:id="@+id/shelfChannelsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="65dp"
        android:paddingEnd="65dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:alpha="0"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/shelfChannels"
            android:layout_width="match_parent"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Opens what the shelf shows (ShelfFeed/ChannelFeed item): Up from the dock lands here, Left/Right turn the
         pages, OK opens. Positioned under the title in code; hidden while nothing is shown. -->
    <TextView
        android:id="@+id/shelfOpen"
        style="@style/TopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:alpha="0"
        android:visibility="gone"
        android:focusable="true"
        android:textSize="16sp"
        android:minHeight="42dp"
        android:paddingStart="20dp"
        android:paddingEnd="22dp"
        android:drawablePadding="10dp"
        android:text="@string/watch_now"
        android:drawableStart="@drawable/ic_np_play" />

    <!-- Now Playing card on the top shelf (NowPlaying): cover, title, artist and app, progress. Positioned above the
         dock in code; shown instead of the posters while something plays. -->
    <LinearLayout
        android:id="@+id/nowPlaying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        android:visibility="gone">

        <ImageView
            android:id="@+id/npCover"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/now_playing_cover_bg"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/now_playing"
                android:textAllCaps="true"
                android:letterSpacing="0.18"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/npTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxWidth="640dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp"
                android:fontFamily="@font/outfit_regular"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/npArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="640dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_regular" />

            <ProgressBar
                android:id="@+id/npProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="420dp"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:max="1000"
                android:progressDrawable="@drawable/now_playing_progress" />

            <!-- Previous, play/pause, next, close: Up from the dock reaches them. A video gets Continue watching and
                 close instead (MainActivity.showNowPlaying). -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/npResume"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_gravity="center_vertical"
                    android:visibility="gone"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="22dp"
                    android:background="@drawable/np_resume_bg"
                    android:text="@string/continue_watching"
                    android:textColor="#FF111111"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.01"
                    android:drawableStart="@drawable/ic_np_play"
                    android:drawableTint="#FF111111"
                    android:drawablePadding="8dp" />

                <TextView
                    android:id="@+id/npPrev"
                    style="@style/TopIconButton"
                    android:layout_marginStart="0dp"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_prev" />

                <TextView
                    android:id="@+id/npPlay"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_pause" />

                <TextView
                    android:id="@+id/npNext"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_next" />

                <TextView
                    android:id="@+id/npExpand"
                    style="@style/TopIconButton"
                    android:layout_marginStart="28dp"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_expand" />

                <TextView
                    android:id="@+id/npOpen"
                    style="@style/TopIconButton"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_open" />

                <TextView
                    android:id="@+id/npClose"
                    style="@style/TopIconButton"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_close" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit_light"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- No clipping down to the pills: with advanced effects a focused pill scales up past its row. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Clock and temperature at the top left (config.xml top_clock, weather). Not focusable. -->
            <LinearLayout
                android:id="@+id/topInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="11dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextClock
                    android:id="@+id/topClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="30sp"
                    android:fontFamily="@font/outfit_light"
                    android:includeFontPadding="false" />

                <!-- Thin divider, weather symbol and temperature: one line with the clock, a step dimmer. -->
                <View
                    android:id="@+id/topDivider"
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="#4DFFFFFF"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/topWeatherIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.75"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/topTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BFFFFFFF"
                    android:textSize="30sp"
                    android:fontFamily="@font/outfit_light"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="@bool/date_single_line"
                            android:maxLines="2"
                            android:lineSpacingExtra="6dp"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format_home"
                            android:format24Hour="@string/date_format_home"
                            android:textColor="#A6FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Shown only when show_stats is on. Outside leftBlock, so the top buttons stay level with the clock
                 row; gone, it takes no space. -->
            <TextView
                android:id="@+id/stats"
                android:layout_width="0dp"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:layout_alignEnd="@id/leftBlock"
                android:gravity="left"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">


                <!-- Search over apps, channels and the shelves (SearchDialog); hold OK for voice. -->
                <TextView
                    android:id="@+id/btnSearch"
                    style="@style/TopButton"
                    android:text="@string/search"
                    android:drawableStart="@drawable/ic_search"
                    android:nextFocusDown="@+id/grid" />

                <!-- The pill, stretched into a text field while searching (MainActivity.openSearch); hidden otherwise. -->
                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/search_field_bg"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:hint="@string/search_hint"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit_medium"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="9dp"
                    android:drawableTint="#E6FFFFFF"
                    android:singleLine="true"
                    android:inputType="text|textNoSuggestions"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:visibility="gone" />

                <!-- Voice search, at the field's right end while searching. -->
                <TextView
                    android:id="@+id/searchMic"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/search_hint"
                    android:drawableStart="@drawable/ic_mic"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <!-- Connected Bluetooth headphones or speaker: its own round button, opens Bluetooth settings. -->
                <TextView
                    android:id="@+id/btnAudio"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/connected"
                    android:drawableStart="@drawable/ic_headphones"
                    android:nextFocusDown="@+id/grid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />

                <!-- Profile at the far right (config.xml profile_button): the photo from profile.jpg in the
                     launcher's files folder (tools/theme.sh pushes it), a person glyph without one. Opens Accounts
                     and profiles. -->
                <ImageView
                    android:id="@+id/btnProfile"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="14dp"
                    android:layout_gravity="center_vertical"
                    android:padding="3dp"
                    android:background="@drawable/avatar_bg"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/profiles"
                    android:nextFocusDown="@+id/grid"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Full-screen Now Playing (ambient screen): the cover over a flowing backdrop in its colours, title, artist,
         progress; opened from the card's expand button. OK pauses, Left/Right skip, any other key brings Home back. -->
    <FrameLayout
        android:id="@+id/ambientScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:alpha="0">

        <com.gathin.tvhome.AmbientView
            android:id="@+id/ambientBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- A quiet darkening towards the bottom, so the titles and buttons read over the brightest colours. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ambient_scrim"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/ambientCover"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:scaleType="centerCrop"
                android:elevation="28dp"
                android:contentDescription="@string/now_playing" />

            <TextView
                android:id="@+id/ambientTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:maxWidth="680dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="-0.01"
                android:includeFontPadding="false"
                android:shadowColor="#59000000"
                android:shadowRadius="12"
                android:shadowDy="2" />

            <TextView
                android:id="@+id/ambientArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:maxWidth="760dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D1FFFFFF"
                android:textSize="17sp"
                android:fontFamily="@font/outfit_regular"
                android:includeFontPadding="false"
                android:shadowColor="#40000000"
                android:shadowRadius="8" />

            <!-- The bar with the time gone and the time left at its ends, as a music player draws it. -->
            <LinearLayout
                android:layout_width="420dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/ambientProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/now_playing_progress" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/ambientElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/ambientRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.04" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Previous, play/pause, next, then open the player app and close: focusable, Left and Right move between
                 them, OK presses; the media keys work too, and Back brings Home back. The row fades out when the remote
                 rests for a few seconds and any key brings it back (ambientControls). -->
            <LinearLayout
                android:id="@+id/ambientControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/ambientPrev"
                    style="@style/TopIconButton"
                    android:layout_marginStart="0dp"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_prev" />

                <TextView
                    android:id="@+id/ambientPlay"
                    style="@style/TopIconButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="22dp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_pause" />

                <TextView
                    android:id="@+id/ambientNext"
                    style="@style/TopIconButton"
                    android:layout_marginStart="22dp"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_next" />

                <!-- The two that are not about the music, a step smaller and quieter, set apart from the three. -->
                <TextView
                    android:id="@+id/ambientOpen"
                    style="@style/TopIconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="48dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:alpha="0.8"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_open" />

                <TextView
                    android:id="@+id/ambientClose"
                    style="@style/TopIconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:alpha="0.8"
                    android:contentDescription="@string/now_playing"
                    android:drawableStart="@drawable/ic_np_close" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>

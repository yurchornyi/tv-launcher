<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Headphones icon and connect banner (AudioDevices, BluetoothReceiver, AudioBanner). build-and-install grants
         both: BLUETOOTH_CONNECT with pm grant, the overlay with appops. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Only for the optional temperature (config.xml weather): one Open-Meteo request per half hour. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The programs apps publish to Android TV's home-screen channels, for the top shelf (ChannelFeed). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Self-update (Updater): hands a downloaded build to Android's installer, which asks to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The full-screen player keeps the screen on, with no screensaver, while it is up (MainActivity.holdScreen). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Home stays alive in the background (HomeKeeper): TCL force-stops a cached launcher once a minute. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The sleep timer's alarms (SleepTimer): Android 14 refuses even setAlarmClock without an exact-alarm right.
         USE_EXACT_ALARM is granted at install from API 33; SCHEDULE_EXACT_ALARM covers 31-32. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Granted once over adb by build-and-install (a development permission): the launcher keeps its sleep timer
         service and Now Playing access switched on by itself after updates (SelfSetup). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Spoken search in the launcher's own field (VoiceSearch); build-and-install grants it, else it is asked for once. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed since Android 10 to read the Wi-Fi network name for the network pill. Never requested at
         runtime: build-and-install grants it with pm grant, so lint's Android 12 "ask for COARSE with
         FINE" rule does not apply here. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Asked for together with the fine one (Android 12+ needs both in the request) on a TV not set up over adb. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- SmartTube's own settings for the account (AppSettings): reading the backup SmartTube keeps in
         Android/media/<its package> needs all-files access, which build-and-install grants with appops. Never asked
         for at runtime; without it the TV only takes settings in. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles, and the
         apps that declare a module card (docs/specs/card.md). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
        </intent>
        <!-- China-market MIUI TV firmware: the Settings and Wi-Fi pills fall back to Xiaomi's settings app. -->
        <package android:name="com.xiaomi.mitv.settings" />
        <!-- Voice input for Search (RecognizerIntent), so its activities can be listed and the TV's own chosen. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the TV's own app list, so it can be opened from the stock home screen too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LauncherSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />
        <!-- The optional account that keeps the owner's TVs alike (Account). -->
        <activity
            android:name=".AccountActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustPan"
            android:screenOrientation="landscape" />
        <!-- Remote Settings button panel (settings_key_panel); own task so the app behind stays put. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in: HOME_KEY_SERVICE=1
             build-and-install.sh; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The remote's Input button (KEYCODE_TV or KEYCODE_TV_INPUT) opens the input switcher, and input_key_keycodes and
         app_keys (config.xml or a theme) bring back other remote buttons; see InputKeyService. -->
        <service
            android:name=".InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>

        <!-- The sleep timer (SleepTimer): the alarm's receiver, and the accessibility service that puts the TV to
             sleep. build-and-install enables the service. -->
        <receiver
            android:name=".SleepReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <!-- Exported only to the shell (DUMP), so the timer's end can be tried over adb:
                 am broadcast -n com.gathin.tvhome/.SleepReceiver -->
            <intent-filter>
                <action android:name="com.gathin.tvhome.action.SLEEP_NOW" />
            </intent-filter>
        </receiver>
        <!-- A minute before the sleep timer ends: the card offering to extend it (SleepWarning). -->
        <receiver
            android:name=".SleepWarning$Receiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Exported only to the shell (DUMP), like SleepReceiver, so the card can be tried over adb:
             am broadcast -n 'com.gathin.tvhome/.SleepWarning$Receiver' -->
        <service
            android:name=".SleepService"
            android:exported="true"
            android:label="@string/sleep_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sleep_service" />
        </service>

        <!-- Media sessions for the Now Playing card (NowPlaying). build-and-install allows it as a listener. -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="@string/now_playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Hands SmartTube the account's backup of its settings as a zip it can read (AppSettings). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- Keeps Home alive while an app is in front and opens it when the TV wakes (HomeKeeper). -->
        <service
            android:name=".HomeKeeper"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the TV launcher alive while another app is in front" />
        </service>

        <!-- The installer's answer about a self-update (Updater, UpdateReceiver). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
        <!-- Twice a day over Wi-Fi: downloads a newer launcher while another app is in front (UpdateJob). -->
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- The new build after a self-update: brings Home back (UpdateReceiver.Replaced). -->
        <receiver
            android:name=".UpdateReceiver$Replaced"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <!-- The same receiver for adb tests of the banner; only the shell (DUMP) may send it. -->
        <receiver
            android:name=".BluetoothTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.gathin.tvhome.action.TEST_AUDIO_BANNER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
